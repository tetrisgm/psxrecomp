/* Triangle-local interpolation keeps identical PGXP primitives independent of
 * the VRAM page origin used by the hardware interpolator. */
static const char *TEX_GS =
    "#version 330\n"
    "layout(triangles) in; layout(triangle_strip,max_vertices=3) out;\n"
    "in vec2 g_raster[];\n"
    "noperspective in vec2 g_uv[];\n"
    "noperspective out vec2 v_uv;\n"
    "noperspective in vec4 g_col[];\n"
    "noperspective out vec4 v_col;\n"
    "noperspective in vec2 g_uv_p[];\n"
    "noperspective out vec2 v_uv_p;\n"
    "flat in int g_persp[];\n"
    "flat out int v_persp;\n"
    "flat in ivec2 g_tpage[];\n"
    "flat out ivec2 v_tpage;\n"
    "flat in ivec2 g_clut[];\n"
    "flat out ivec2 v_clut;\n"
    "flat in int g_depth[];\n"
    "flat out int v_depth;\n"
    "flat in int g_raw[];\n"
    "flat out int v_raw;\n"
    "flat in ivec4 g_limits[];\n"
    "flat out ivec4 v_limits;\n"
    "flat in int g_semi[];\n"
    "flat out int v_semi;\n"
    "flat in int g_dith[];\n"
    "flat out int v_dith;\n"
    "flat in int g_twin[];\n"
    "flat out int v_twin;\n"
    "flat in vec4 g_hd_source[];\n"
    "flat out vec4 v_hd_source;\n"
    "flat in int g_hd_mode[];\n"
    "flat out int v_hd_mode;\n"
    "flat in int g_filter[];\n"
    "flat out int v_filter;\n"
    "noperspective in float g_iw[];\n"
    "noperspective out float v_iw;\n"
    "noperspective in vec3 g_col_p[];\n"
    "noperspective out vec3 v_col_p;\n"
    "flat in int g_cp[];\n"
    "flat out int v_cp;\n"
    "noperspective in float g_b3d[];\n"
    "noperspective out float v_b3d;\n"
    "noperspective in vec2 g_npos[];\n"
    "noperspective out vec2 v_npos;\n"
    "flat out vec2 t_pos[3]; flat out vec3 t_uvq[3]; flat out vec4 t_colq[3];\n"
    "void main(){\n"
    "for(int i=0;i<3;i++){\n"
    "t_pos[0]=g_raster[0];\n"
    "t_uvq[0]=vec3(g_uv[0]*(g_persp[0]!=0?g_iw[0]:1.0),g_persp[0]!=0?g_iw[0]:1.0);\n"
    "t_colq[0]=vec4(g_col[0].rgb*(g_cp[0]!=0?g_iw[0]:1.0),g_cp[0]!=0?g_iw[0]:1.0);\n"
    "t_pos[1]=g_raster[1];\n"
    "t_uvq[1]=vec3(g_uv[1]*(g_persp[1]!=0?g_iw[1]:1.0),g_persp[1]!=0?g_iw[1]:1.0);\n"
    "t_colq[1]=vec4(g_col[1].rgb*(g_cp[1]!=0?g_iw[1]:1.0),g_cp[1]!=0?g_iw[1]:1.0);\n"
    "t_pos[2]=g_raster[2];\n"
    "t_uvq[2]=vec3(g_uv[2]*(g_persp[2]!=0?g_iw[2]:1.0),g_persp[2]!=0?g_iw[2]:1.0);\n"
    "t_colq[2]=vec4(g_col[2].rgb*(g_cp[2]!=0?g_iw[2]:1.0),g_cp[2]!=0?g_iw[2]:1.0);\n"
    "v_uv=g_uv[i];\n"
    "v_col=g_col[i];\n"
    "v_uv_p=g_uv_p[i];\n"
    "v_persp=g_persp[i];\n"
    "v_tpage=g_tpage[i];\n"
    "v_clut=g_clut[i];\n"
    "v_depth=g_depth[i];\n"
    "v_raw=g_raw[i];\n"
    "v_limits=g_limits[i];\n"
    "v_semi=g_semi[i];\n"
    "v_dith=g_dith[i];\n"
    "v_twin=g_twin[i];\n"
    "v_hd_source=g_hd_source[i];\n"
    "v_hd_mode=g_hd_mode[i];\n"
    "v_filter=g_filter[i];\n"
    "v_iw=g_iw[i];\n"
    "v_col_p=g_col_p[i];\n"
    "v_cp=g_cp[i];\n"
    "v_b3d=g_b3d[i];\n"
    "v_npos=g_npos[i];\n"
    "gl_Position=gl_in[i].gl_Position;EmitVertex();\n"
    "}EndPrimitive();}\n"
;
